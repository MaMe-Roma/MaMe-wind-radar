{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radar kite",
  "version": "4.1.2",
  "identifier": "com.madhattermatt.radarkite",
  "build": {
    "frontendDist": "../pagina"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Weather",
    "shortDescription": "Radar kite: vento previsto e stazioni degli spot del Lazio",
    "copyright": "@MadHatterMatt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRDVDNTNCNDM4RTc5MzQKUldRMGVZNURPOFhWVW1UTnNrWUZ4UlAvNnBGNTZYcFZjZmxOQ2o1SFFadUhpUXpIS1Y3RGgzZG0K",
      "endpoints": [
        "https://github.com/MaMe-Roma/MaMe-wind-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}